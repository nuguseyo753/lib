local SaveManager = {
    Folder = "Nuke Example",
    Ignore = {},
}

-- SaveManager keeps create/load/overwrite/autoload controls in one place.
-- It stores configs under Folder/settings when file functions are available.
function SaveManager:SetLibrary(library)
    self.Library = library
end

function SaveManager:SetFolder(folder)
    self.Folder = folder or self.Folder
end

function SaveManager:IgnoreThemeSettings()
end

function SaveManager:SetIgnoreIndexes(indexes)
    self.Ignore = indexes or {}
end

function SaveManager:GetFolder()
    return (self.Folder or "Nuke Example") .. "/settings"
end

function SaveManager:BuildFolderTree()
    if not makefolder or not isfolder then
        return
    end
    if not isfolder(self.Folder) then
        makefolder(self.Folder)
    end
    if not isfolder(self:GetFolder()) then
        makefolder(self:GetFolder())
    end
end

function SaveManager:GetConfigPath(name)
    return self:GetFolder() .. "/" .. name .. ".cfg"
end

function SaveManager:GetSelectedConfig()
    local name = Options.SaveManager_ConfigName and Options.SaveManager_ConfigName.Value
    if type(name) == "string" then
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
    end

    if not name or name == "" then
        name = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
    end

    if type(name) ~= "string" or name == "" then
        return nil
    end

    return name:gsub("%.cfg$", "")
end

function SaveManager:RefreshConfigList()
    self:BuildFolderTree()
    if not listfiles then
        return {}
    end

    local ok, files = pcall(listfiles, self:GetFolder())
    if not ok or type(files) ~= "table" then
        return {}
    end

    local names = {}
    for _, file in ipairs(files) do
        local name = tostring(file):gsub("\\", "/"):match("([^/]+)%.cfg$")
        if name then
            table.insert(names, name)
        end
    end

    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)

    return names
end

function SaveManager:GetAutoloadConfig()
    if not isfile or not readfile then
        return nil
    end

    local path = self:GetFolder() .. "/autoload.txt"
    if not isfile(path) then
        return nil
    end

    local name = readfile(path)
    if type(name) == "string" then
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
    end

    return name ~= "" and name or nil
end

function SaveManager:UpdateList()
    if Options.SaveManager_ConfigList then
        Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
    end
end

function SaveManager:Save(name)
    name = name or self:GetSelectedConfig()
    if not name or not writefile then
        return
    end

    self:BuildFolderTree()
    writefile(self:GetConfigPath(name), Nuke:get_config())
    self:UpdateList()
end

function SaveManager:Load(name)
    name = name or self:GetSelectedConfig()
    if not name or not isfile or not readfile then
        return
    end

    local path = self:GetConfigPath(name)
    if isfile(path) then
        Nuke:load_config(readfile(path))
    end
end

function SaveManager:BuildConfigSection(tab)
    local group = tab:AddRightGroupbox("Configuration")
    local autoloadLabel

    -- Config name textbox.
    -- If this is empty, the selected item from the config list is used.
    group:AddInput("SaveManager_ConfigName", {
        Text = "Config name",
        Default = "",
    })

    -- Existing config list.
    -- Use Refresh list after manually adding/removing files.
    group:AddDropdown("SaveManager_ConfigList", {
        Text = "Config list",
        Values = self:RefreshConfigList(),
        Default = nil,
    })

    -- Create/Load/Overwrite use the config name or selected config list item.
    group:AddButton({
        Text = "Create config",
        Func = function()
            self:Save()
        end,
    })

    -- Stores the selected config name in autoload.txt.
    group:AddButton({
        Text = "Load config",
        Func = function()
            self:Load()
        end,
    })

    group:AddButton({
        Text = "Overwrite config",
        Func = function()
            self:Save()
        end,
    })

    group:AddButton({
        Text = "Refresh list",
        Func = function()
            self:UpdateList()
        end,
    })

    group:AddButton({
        Text = "Set as autoload",
        Func = function()
            local name = self:GetSelectedConfig()
            if name and writefile then
                self:BuildFolderTree()
                writefile(self:GetFolder() .. "/autoload.txt", name)
                if autoloadLabel then
                    autoloadLabel:SetValue("Current autoload config: " .. name)
                end
            end
        end,
    })

    autoloadLabel = group:AddLabel("Current autoload config: " .. (self:GetAutoloadConfig() or "none"))
end

function SaveManager:LoadAutoloadConfig()
    local name = self:GetAutoloadConfig()
    if name then
        self:Load(name)
    end
end

-- Window setup
-- Title, Size, and menu behavior are configured here.
local Window = Library:CreateWindow({
    -- Set AutoShow to true if you want the menu to appear when it is created
    -- Position and Size are also valid options here, but not needed for this example

    Title = getUiTitle(),
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2,
})

-- CALLBACK NOTE:
-- Passing callback functions in element parameters works, but :OnChanged is a clean way
-- to separate UI creation from your actual script logic.

-- Tabs are the main pages shown in the left sidebar.
local Tabs = {
    -- Creates a new tab titled Main
    Main = Window:AddTab("Main"),

    -- This tab is used for menu, theme, and config controls.
    ["UI Settings"] = Window:AddTab("UI Settings"),
}

-- Groupboxes organize controls inside a tab.
-- AddLeftGroupbox and AddRightGroupbox place the box in the left or right column.
local LeftGroupBox = Tabs.Main:AddLeftGroupbox("Groupbox")

-- Groupbox:AddToggle
-- Arguments: Index, Options
-- Options: Text, Default, Type, Tooltip, Callback
LeftGroupBox:AddToggle("MyToggle", {
    Text = "This is a toggle",
    Default = true,
    Tooltip = "This is a tooltip",
    Callback = function(Value)
        print("[cb] MyToggle changed to:", Value)
    end,
})

-- Toggles is a table shared by the example.
-- You can read the value later with Toggles.MyToggle.Value.
Toggles.MyToggle:OnChanged(function()
    print("MyToggle changed to:", Toggles.MyToggle.Value)
end)

-- You can also change a control from code.
Toggles.MyToggle:SetValue(false)

-- Groupbox:AddButton
-- Arguments: { Text, Func, Tooltip }
-- AddButton returns a button object, so you can add a sub button below it.
local MyButton = LeftGroupBox:AddButton({
    Text = "Button",
    Func = function()
        print("You clicked a button!")
    end,
    Tooltip = "This is the main button",
})

-- Sub buttons are useful for related actions under one main button.
MyButton:AddButton({
    Text = "Sub button",
    Func = function()
        print("You clicked a sub button!")
    end,
    Tooltip = "This is the sub button",
})

-- Groupbox:AddLabel
-- Arguments: Text
LeftGroupBox:AddLabel("This is a label")
LeftGroupBox:AddLabel("This is a label\n\nwhich wraps its text!")

-- Groupbox:AddDivider
-- Adds spacing between groups of controls.
LeftGroupBox:AddDivider()

-- Groupbox:AddSlider
-- Arguments: Index, SliderOptions
-- SliderOptions: Text, Default, Min, Max, Rounding, Suffix, Callback
LeftGroupBox:AddSlider("MySlider", {
    Text = "This is my slider!",
    Default = 0,
    Min = 0,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        print("[cb] MySlider was changed! New value:", Value)
    end,
})

-- Options stores non-toggle controls such as sliders, dropdowns, inputs, and color pickers.
Options.MySlider:OnChanged(function()
    print("MySlider was changed! New value:", Options.MySlider.Value)
end)

Options.MySlider:SetValue(3)

-- Groupbox:AddInput
-- Arguments: Index, InputOptions
-- InputOptions: Text, Default, Placeholder, Tooltip, Callback
LeftGroupBox:AddInput("MyTextbox", {
    Default = "My textbox!",
    Text = "This is a textbox",
    Tooltip = "This is a tooltip",
    Placeholder = "Placeholder text",
    Callback = function(Value)
        print("[cb] Text updated. New text:", Value)
    end,
})

Options.MyTextbox:OnChanged(function()
    print("Text updated. New text:", Options.MyTextbox.Value)
end)

-- Groupbox:AddDropdown
-- Arguments: Index, DropdownOptions
-- DropdownOptions: Text, Values, Default, Multi, MaxVisibleOptions, MaxHeight, Tooltip, Callback
LeftGroupBox:AddDropdown("MyDropdown", {
    Values = {"This", "is", "a", "dropdown"},
    Default = 1,
    Multi = false,
    Text = "A dropdown",
    Tooltip = "This is a tooltip",
    Callback = function(Value)
        print("[cb] Dropdown got changed. New value:", Value)
    end,
})

Options.MyDropdown:OnChanged(function()
    print("Dropdown got changed. New value:", Options.MyDropdown.Value)
end)

Options.MyDropdown:SetValue("This")

-- Multi dropdowns return a table of selected values.
LeftGroupBox:AddDropdown("MyMultiDropdown", {
    Values = {"This", "is", "a", "dropdown"},
    Default = 1,
    Multi = true,
    Text = "A multi dropdown",
    Tooltip = "This is a tooltip",
    Callback = function(Value)
        print("[cb] Multi dropdown got changed:", Value)
    end,
})

Options.MyMultiDropdown:OnChanged(function()
    print("Multi dropdown got changed:")
    for key, value in next, Options.MyMultiDropdown.Value do
        print(key, value)
    end
end)

Options.MyMultiDropdown:SetValue({
    This = true,
    is = true,
})

-- SpecialType = "Player" fills the dropdown with current player names.
LeftGroupBox:AddDropdown("MyPlayerDropdown", {
    SpecialType = "Player",
    Text = "A player dropdown",
    Tooltip = "This is a tooltip",
    Callback = function(Value)
        print("[cb] Player dropdown got changed:", Value)
    end,
})

-- AddColorPicker can be chained from a label or other option object.
LeftGroupBox:AddLabel("Color"):AddColorPicker("ColorPicker", {
    Default = Color3.new(0, 1, 0),
    Title = "Some color",
    Transparency = 0,
    Callback = function(Value)
