-- Set it to "" if you want the title area hidden.
local UI_TITLE = "Ui" -- Set this to "" if you want the title hidden.

local function getUiTitle()
    return UI_TITLE == nil and "" or tostring(UI_TITLE)
end

local Nuke = loadstring(game:HttpGet(repo .. "ui"))()
local ActiveWindow

local env = (getgenv and getgenv()) or _G
env.Toggles = env.Toggles or {}
env.Options = env.Options or {}

local Toggles = env.Toggles
local Options = env.Options
local Players = game:GetService("Players")

-- Small icon helper used by this example.
-- Nuke UI also accepts icons directly through sections/tabs.
local function iconForName(name)
    local lower = string.lower(tostring(name or ""))

    if lower:find("config") then
        return "rbxassetid://6031280882"
    elseif lower:find("setting") then
        return "rbxassetid://6031280882"
    elseif lower:find("menu") then
        return "rbxassetid://6034767608"
    elseif lower:find("theme") or lower:find("color") then
        return "rbxassetid://6031763426"
    elseif lower:find("save") then
        return "rbxassetid://6034287594"
    elseif lower:find("aim") or lower:find("target") then
        return "rbxassetid://6035047409"
    elseif lower:find("visual") or lower:find("esp") then
        return "rbxassetid://6031075938"
    elseif lower:find("world") then
        return "rbxassetid://6034684949"
    elseif lower:find("tab 1") or lower:match("1$") then
        return "rbxassetid://6034287518"
    elseif lower:find("tab 2") or lower:match("2$") then
        return "rbxassetid://6031280882"
    end

    return "rbxassetid://6022668898"
end

-- Converts short key names into Roblox Enum values.
local function parseKey(value)
    if typeof(value) == "EnumItem" then
        return value
    end

    if type(value) == "table" then
        value = value.key or value.Key or value[1] or value.Value
    end

    if type(value) ~= "string" then
        return value
    end

    if value == "MB1" then
        return Enum.UserInputType.MouseButton1
    elseif value == "MB2" then
        return Enum.UserInputType.MouseButton2
    elseif value == "MB3" then
        return Enum.UserInputType.MouseButton3
    end

    return Enum.KeyCode[value] or Enum.UserInputType[value] or value
end

-- Converts multi dropdown maps into sorted arrays for the UI control.
local function normalizeMulti(value)
    if type(value) ~= "table" then
        return value
    end

    if #value > 0 then
        return value
    end

    local list = {}
    for option, enabled in pairs(value) do
        if enabled then
            table.insert(list, option)
        end
    end

    table.sort(list, function(a, b)
        return tostring(a) < tostring(b)
    end)

    return list
end

-- Converts selected arrays back into map form for Options.MyDropdown.Value.
local function toMultiMap(value)
    if type(value) ~= "table" then
        return value
    end

    if #value == 0 then
        return value
    end

    local map = {}
    for _, option in ipairs(value) do
        map[option] = true
    end
    return map
end

-- Runs every callback registered with Option:OnChanged.
local function fireChanged(option, ...)
    if not option._changed then
        return
    end

    for _, callback in ipairs(option._changed) do
        task.spawn(callback, ...)
    end
end

-- Option objects keep every control easy to read and update later:
-- Options.Index.Value, Options.Index:SetValue(...), and Options.Index:OnChanged(...).
local function makeOption(store, id, default, control)
    local option = store[id] or {}
    option.Value = option.Value == nil and default or option.Value
    option._control = control
    option._changed = option._changed or {}

    function option:SetValue(value)
        if self._kind == "multi_dropdown" then
            value = normalizeMulti(value)
        elseif self._kind == "keybind" then
            value = {
                key = parseKey(value),
                mode = type(value) == "table" and (value.mode or value.Mode or value[2]) or self.Mode or "Toggle",
                active = self.Toggled == true,
            }
        end

        if self._control and self._control.set then
            self._control.set(value)
        elseif self._control and self._control.SetText then
            self._control:SetText(value)
        elseif self._control and self._control.Set then
            self._control:Set(value)
        else
            self.Value = value
            fireChanged(self, value)
        end
    end

    function option:SetValues(values)
        self.Values = values or {}
        if self._control and self._control.refresh_options then
            self._control.refresh_options(self.Values)
        end
    end

    function option:OnChanged(callback)
        table.insert(self._changed, callback)
    end

    function option:OnClick(callback)
        self._clicked = callback
    end

    function option:GetState()
        return self.Toggled == true or self.Value == true
    end

    function option:SetValueRGB(color, transparency)
        self.Value = color
        self.Transparency = transparency or self.Transparency or 0
        if self._control and self._control.set then
            self._control.set(color, self.Transparency)
        end
    end

    function option:AddColorPicker(colorId, config)
        config = config or {}
        local colorOption = makeOption(Options, colorId, config.Default or Color3.fromRGB(255, 255, 255))
        colorOption.Transparency = config.Transparency or 0

        local parent = self._control or self._section
        local control = parent:colorpicker({
            name = config.Title or config.Text or "",
            flag = colorId,
            color = config.Default or config.Color or Color3.fromRGB(255, 255, 255),
            alpha = config.Transparency ~= nil and (1 - config.Transparency) or nil,
            info = config.Tooltip,
            callback = function(color, transparency)
                colorOption.Value = color
                colorOption.Transparency = transparency or 0
                if config.Callback then
                    task.spawn(config.Callback, color)
                end
                fireChanged(colorOption, color, transparency)
            end,
        })

        colorOption._control = control
        return colorOption
    end

    function option:AddKeyPicker(keyId, config)
        config = config or {}
        local keyOption = makeOption(Options, keyId, parseKey(config.Default or "None"))
        keyOption._kind = "keybind"
        keyOption.Type = "KeyPicker"
        keyOption.Key = keyOption.Key or keyOption.Value
        keyOption.Mode = config.Mode or "Toggle"

        local control = self._section:keybind({
            name = config.Text or keyId,
            flag = keyId,
            key = parseKey(config.Default),
            mode = keyOption.Mode,
            info = config.Tooltip,
            target = keyId == "MenuKeybind" and ActiveWindow or nil,
            no_ui = config.NoUI == true,
            show_in_list = config.NoUI ~= true,
            callback = function(active)
                keyOption.Value = control and control.key or keyOption.Value
                keyOption.Key = control and control.key or keyOption.Key
                keyOption.Mode = control and control.mode or keyOption.Mode
                keyOption.Toggled = active == true
                if keyId == "MenuKeybind" and ActiveWindow and ActiveWindow.set_menu_key then
                    ActiveWindow.set_menu_key(keyOption.Key or keyOption.Value)
                end
                if config.Callback then
                    task.spawn(config.Callback, active)
                end
                if config.ChangedCallback then
                    task.spawn(config.ChangedCallback, keyOption.Value)
                end
                if keyOption._clicked then
                    task.spawn(keyOption._clicked, active)
                end
                fireChanged(keyOption, keyOption.Value)
            end,
        })

        keyOption._control = control
        return keyOption
    end

    store[id] = option
    return option
end

local function createGroup(section, parentGroup)
    local group = {
        _section = section,
        _parent = parentGroup,
        _children = {},
        _controls = {},
        _dependencies = nil,
        _visible = parentGroup == nil or parentGroup._visible ~= false,
    }

    if parentGroup then
        table.insert(parentGroup._children, group)
    end

    local function readDependencyValue(source)
        if type(source) ~= "table" then
            return source
        end

        if source.GetState then
            return source:GetState()
        end

        if source.Value ~= nil then
            return source.Value
        end

        if source.Toggled ~= nil then
            return source.Toggled
        end

        return nil
    end

    local function setControlVisible(entry, visible)
        local control = entry
        if type(entry) == "table" and entry._control then
            control = entry._control
        end

        if type(control) ~= "table" then
            return
        end

        if control.SetVisibility then
            control:SetVisibility(visible)
        elseif control.SetVisible then
            control:SetVisible(visible)
        end
    end

    function group:_dependenciesPass()
        if not self._dependencies then
            return true
        end

        for _, dependency in ipairs(self._dependencies) do
            local source = dependency[1] or dependency.Option or dependency.option
            local expected = dependency[2]

            if expected == nil then
                expected = dependency.Value
            end
            if expected == nil then
                expected = dependency.value
            end
            if expected == nil then
                expected = true
            end

            if readDependencyValue(source) ~= expected then
                return false
            end
        end

        return true
    end

    function group:_applyVisibility()
        local parentVisible = self._parent == nil or self._parent._visible ~= false
        self._visible = parentVisible and self:_dependenciesPass()

        for _, control in ipairs(self._controls) do
            setControlVisible(control, self._visible)
        end

        for _, child in ipairs(self._children) do
            child:_applyVisibility()
        end
    end

    function group:_track(control)
        table.insert(self._controls, control)
        setControlVisible(control, self._visible)
        return control
    end

    function group:SetupDependencies(dependencies)
        self._dependencies = dependencies or {}

        for _, dependency in ipairs(self._dependencies) do
            local source = dependency[1] or dependency.Option or dependency.option
            if type(source) == "table" and source.OnChanged then
                source:OnChanged(function()
                    self:_applyVisibility()
                end)
            end
        end

        self:_applyVisibility()
    end

    -- Groupbox:AddToggle
    -- Arguments: Index, Options
    -- Options: Text, Default, Tooltip, Callback
    function group:AddToggle(id, config)
        config = config or {}
        local option = makeOption(Toggles, id, config.Default == true)

        local control = section:toggle({
            name = config.Text or id,
            flag = id,
            default = config.Default == true,
            type = config.Type or config.type,
            info = config.Tooltip,
            callback = function(value)
                option.Value = value == true
                if config.Callback then
                    task.spawn(config.Callback, option.Value)
                end
                fireChanged(option, option.Value)
            end,
        })

        option._control = control
        option._section = section
        return group:_track(option)
    end

    -- Groupbox:AddButton
    -- Supports both AddButton("Text", callback) and AddButton({ Text = ..., Func = ... }).
    -- Returns a small button object so you can chain :AddButton for sub buttons.
    function group:AddButton(config, callback)
        if type(config) ~= "table" then
            config = {
                Text = tostring(config or "Button"),
                Func = callback,
            }
        end

        local button = {}
        local control = section:button({
            name = config.Text or config.Name or "Button",
            info = config.Tooltip,
            callback = config.Func or config.Callback or function() end,
        })
        button._control = control

        function button:AddButton(subConfig)
            return group:AddButton(subConfig)
        end

        return group:_track(button)
    end

    -- Groupbox:AddLabel
    -- Arguments: Text
    -- The returned object supports :AddColorPicker and :AddKeyPicker.
    function group:AddLabel(text)
        local control = section:label({
            name = tostring(text or ""),
        })
        local option = makeOption(Options, "Label_" .. tostring(text or ""), tostring(text or ""), control)
        option._section = section
        return group:_track(option)
    end

    -- Groupbox:AddDivider
    -- Adds a simple spacer/divider-like label.
    function group:AddDivider()
        local control = section:label({name = " "})
        group:_track({_control = control})
    end

    -- Groupbox:AddSlider
    -- Arguments: Index, SliderOptions
    -- SliderOptions: Text, Default, Min, Max, Rounding, Step, Suffix, Tooltip, Callback
    function group:AddSlider(id, config)
        config = config or {}
        local rounding = tonumber(config.Rounding) or 0
        local interval = tonumber(config.Step or config.Interval) or (rounding > 0 and (1 / (10 ^ rounding)) or 1)
        local option = makeOption(Options, id, config.Default or config.Min or 0)

        local control = section:slider({
            name = config.Text or id,
            flag = id,
            min = config.Min or 0,
            max = config.Max or 100,
            default = config.Default or config.Min or 0,
            interval = interval,
            suffix = config.Suffix or "",
            info = config.Tooltip,
            callback = function(value)
                option.Value = value
                if config.Callback then
                    task.spawn(config.Callback, value)
                end
                fireChanged(option, value)
            end,
        })

        option._control = control
        return group:_track(option)
    end

    -- Groupbox:AddInput
    -- Arguments: Index, InputOptions
    -- InputOptions: Text, Default, Placeholder, Tooltip, Callback
    function group:AddInput(id, config)
        config = config or {}
        local option = makeOption(Options, id, config.Default or "")

        local control = section:textbox({
            name = config.Text or id,
            flag = id,
            default = config.Default or "",
            placeholder = config.Placeholder or config.PlaceholderText or "",
            info = config.Tooltip,
            callback = function(value)
                option.Value = value
                if config.Callback then
                    task.spawn(config.Callback, value)
                end
                fireChanged(option, value)
            end,
        })

        option._control = control
        return group:_track(option)
    end

    -- Groupbox:AddDropdown
    -- Arguments: Index, DropdownOptions
    -- DropdownOptions: Text, Values, Default, Multi, SpecialType, MaxVisibleOptions, MaxHeight, Tooltip, Callback
    function group:AddDropdown(id, config)
        config = config or {}
        local values = config.Values or config.Options or {}

        if config.SpecialType == "Player" then
            values = {}
            for _, player in ipairs(Players:GetPlayers()) do
                table.insert(values, player.Name)
            end
        end

        local default = config.Default
        if type(default) == "number" then
            default = values[default]
        end
        if config.Multi then
            default = type(default) == "table" and normalizeMulti(default) or {default}
        end

        local option = makeOption(Options, id, config.Multi and toMultiMap(default) or default)
        option._kind = config.Multi and "multi_dropdown" or "dropdown"
        option.Values = values

        local control = section:dropdown({
            name = config.Text or id,
            flag = id,
            options = values,
            default = default,
            multi = config.Multi == true,
            max_visible_options = config.MaxVisibleOptions or config.VisibleOptions,
            max_height = config.MaxHeight,
            info = config.Tooltip,
            callback = function(value)
                option.Value = config.Multi and toMultiMap(value) or value
                if config.Callback then
                    task.spawn(config.Callback, option.Value)
                end
                fireChanged(option, option.Value)
            end,
        })

        option._control = control
        return group:_track(option)
    end

    -- Dependency boxes let you group controls that should appear under another control.
    -- SetupDependencies controls whether the nested controls are visible and clickable.
    function group:AddDependencyBox()
        return createGroup(section, group)
    end

    return group
end

-- Creates a small tab helper around Nuke UI pages.
local function createTab(page)
    local tab = {
        _page = page,
        _columns = {},
    }

    local function getColumn(side)
        side = side == "right" and "right" or "left"
        if not tab._columns[side] then
            tab._columns[side] = page:column({size = 0.5})
        end
        return tab._columns[side]
    end

    local function addGroupbox(side, name)
        return createGroup(getColumn(side):section({
            name = name or "Groupbox",
            size = 1,
            default = true,
            icon = iconForName(name),
        }))
    end

    -- Add a groupbox on the left column.
    function tab:AddLeftGroupbox(name)
        return addGroupbox("left", name)
    end

    -- Add a groupbox on the right column.
    function tab:AddRightGroupbox(name)
        return addGroupbox("right", name)
    end

    -- Tabboxes are groupboxes with their own small tab selector inside.
    local function addTabbox(side, name)
        local section = getColumn(side):section({
            name = name or "Tabbox",
            size = 1,
            default = true,
            icon = iconForName(name),
        })

        local root = section.items.elements
        local header = section.items.button
        if section.items.section_title then
            section.items.section_title.Visible = false
        end
        if section.items.Icon then
            section.items.Icon.Visible = false
        end

        local tabbox = {
            Tabs = {},
            Selected = nil,
        }

        local buttons = Nuke:create("Frame", {
            Parent = header,
            Name = "\0",
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BackgroundColor3 = Color3.fromRGB(24, 19, 19),
            BorderSizePixel = 0,
            ZIndex = 20,
        })

        Nuke:create("UIListLayout", {
            Parent = buttons,
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
        })

        local function resizeButtons()
            local count = #tabbox.Tabs
            if count == 0 then
                return
            end

            for _, tabData in ipairs(tabbox.Tabs) do
                tabData.Button.Size = UDim2.new(1 / count, 0, 1, 0)
            end
        end

        local function selectTab(nextTab)
            if tabbox.Selected == nextTab then
                return
            end

            for _, tabData in ipairs(tabbox.Tabs) do
                local selected = tabData == nextTab
                tabData.Container.Visible = selected
                tabData.Container.AutomaticSize = selected and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
                tabData.Container.Size = UDim2.new(1, 0, 0, 0)
                tabData.Button.BackgroundTransparency = selected and 0.05 or 1
                tabData.Label.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
                tabData.Icon.ImageColor3 = selected and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(150, 150, 150)
            end

            tabbox.Selected = nextTab
        end

        function tabbox:AddTab(tabName)
            local tabData = {}
            local index = #self.Tabs + 1

            tabData.Button = Nuke:create("TextButton", {
                Parent = buttons,
                Name = "\0",
                LayoutOrder = index,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                BackgroundTransparency = 1,
                BackgroundColor3 = Color3.fromRGB(34, 27, 27),
                ZIndex = 21,
            })

            tabData.Icon = Nuke:create("ImageLabel", {
                Parent = tabData.Button,
                Name = "\0",
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Image = iconForName(tabName),
                ImageColor3 = Color3.fromRGB(150, 150, 150),
                ZIndex = 22,
            })

            tabData.Label = Nuke:create("TextLabel", {
                Parent = tabData.Button,
                Name = "\0",
                Position = UDim2.new(0, 32, 0, 0),
                Size = UDim2.new(1, -38, 1, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = tostring(tabName or ("Tab " .. index)),
                Font = Enum.Font.Code,
                TextSize = 14,
                TextColor3 = Color3.fromRGB(150, 150, 150),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 22,
            })

            tabData.Container = Nuke:create("Frame", {
                Parent = root,
                Name = "\0",
                LayoutOrder = index,
                Visible = false,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.None,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
            })

            Nuke:create("UIListLayout", {
                Parent = tabData.Container,
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 10),
            })

            table.insert(self.Tabs, tabData)
            resizeButtons()

            tabData.Button.MouseButton1Click:Connect(function()
                selectTab(tabData)
            end)

            if not self.Selected then
                selectTab(tabData)
            end

            local proxy = setmetatable({
                items = {
                    elements = tabData.Container,
                },
            }, getmetatable(section))

            return createGroup(proxy)
        end

        return tabbox
    end

    function tab:AddLeftTabbox(name)
        return addTabbox("left", name)
    end

    function tab:AddRightTabbox(name)
        return addTabbox("right", name)
    end

    return tab
end

-- Public example table used below.
-- It keeps the showcase readable while still calling Nuke UI directly.
local Library = {
    _nuke = Nuke,
    Unloaded = false,
    KeybindFrame = {Visible = false},
}

function Library:CreateWindow(config)
    config = config or {}
    local title = config.Title
    if title == nil then
        title = config.Name
    end

    local rawWindow = Nuke:window({
        name = title == nil and "" or tostring(title),
        size = config.Size or UDim2.new(0, 720, 0, 560),
        menuKey = Enum.KeyCode.End,
    })
    ActiveWindow = rawWindow

    local window = {
        _raw = rawWindow,
        Tabs = {},
    }

    function window:AddTab(name)
        local page = rawWindow:tab({
            name = tostring(name or "Tab"),
            tabs = {"Main"},
            group = tostring(name or "") == "UI Settings" and "Settings" or "General",
        })
        local tab = createTab(page)
        self.Tabs[name] = tab
        return tab
    end

    self._window = rawWindow
    self.Holder = rawWindow.items and rawWindow.items.main
    self.KeybindFrame = Nuke.KeybindFrame or Nuke.keybind_frame

    return window
end

-- Library:Notify
-- Accepts either a string or { Title, Content, Time }.
function Library:Notify(options, time)
    if type(options) ~= "table" then
        return Nuke:notify(tostring(options or ""), time)
    end

    return Nuke:notify({
        name = options.Title or options.Name or "Nuke",
        info = options.Content or options.Text or options.Info or "",
        lifetime = options.Time or options.Duration or 2.2,
    })
end

function Library:SetKeybindFrameVisibility(visible)
    Nuke:set_keybind_frame_visible(visible)
    self.KeybindFrame = Nuke.KeybindFrame or Nuke.keybind_frame
end

function Library:SetWatermarkVisibility(visible)
    Nuke:set_watermark_visible(visible)
end

function Library:SetWatermark(text)
    Nuke:set_watermark(text or (ActiveWindow and ActiveWindow.name) or "Ui")
end

function Library:OnUnload(callback)
    self._unloadCallback = callback
end

function Library:Unload()
    self.Unloaded = true
    if self._unloadCallback then
        task.spawn(self._unloadCallback)
    end
    Nuke:unload_menu()
end

local ThemeManager = {
    Folder = "Nuke Example",
    Themes = {"Red", "Graphite", "Arctic", "Ember", "Mint", "Rose"},
}

-- ThemeManager keeps preset and custom color controls in one place.
-- It applies built-in Nuke presets and keeps the controls synced.
function ThemeManager:SetLibrary(library)
    self.Library = library
end

function ThemeManager:SetFolder(folder)
    self.Folder = folder or self.Folder
end

function ThemeManager:GetPreset(theme)
    if Nuke.GetThemePreset then
        return Nuke:GetThemePreset(theme)
    end
    if Nuke.get_theme_preset then
        return Nuke:get_theme_preset(theme)
    end
end

function ThemeManager:SyncControls(theme)
    local preset = self:GetPreset(theme)
    if not preset then
        return
    end

    if Options.ThemeManager_Accent and preset.accent then
        Options.ThemeManager_Accent:SetValueRGB(preset.accent)
    end
    if Options.ThemeManager_Background and preset.background then
        Options.ThemeManager_Background:SetValueRGB(preset.background)
    end
    if Options.ThemeManager_Surface and preset.surface then
        Options.ThemeManager_Surface:SetValueRGB(preset.surface)
    end
    if Options.ThemeManager_Card and preset.card then
        Options.ThemeManager_Card:SetValueRGB(preset.card)
    end
    if Options.ThemeManager_CardInner and preset.card_inner then
        Options.ThemeManager_CardInner:SetValueRGB(preset.card_inner)
    end
    if Options.ThemeManager_Border and preset.border then
        Options.ThemeManager_Border:SetValueRGB(preset.border)
    end
    if Options.ThemeManager_WindowTransparency and preset.window_transparency then
        Options.ThemeManager_WindowTransparency:SetValue(math.floor(preset.window_transparency * 100 + 0.5))
    end
    if Options.ThemeManager_PanelTransparency and preset.panel_transparency then
        Options.ThemeManager_PanelTransparency:SetValue(math.floor(preset.panel_transparency * 100 + 0.5))
    end
