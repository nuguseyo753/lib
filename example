function ThemeManager:GetPreset(theme)
    if Nuke.GetThemePreset then
        return Nuke:GetThemePreset(theme)
    end
    if Nuke.get_theme_preset then
        return Nuke:get_theme_preset(theme)
    end
end

function ThemeManager:SyncControls(theme)
    local preset = self:GetPreset(theme)
    if not preset then
        return
    end

    if Options.ThemeManager_Accent and preset.accent then
        Options.ThemeManager_Accent:SetValueRGB(preset.accent)
    end
    if Options.ThemeManager_Background and preset.background then
        Options.ThemeManager_Background:SetValueRGB(preset.background)
    end
    if Options.ThemeManager_Surface and preset.surface then
        Options.ThemeManager_Surface:SetValueRGB(preset.surface)
    end
    if Options.ThemeManager_Card and preset.card then
        Options.ThemeManager_Card:SetValueRGB(preset.card)
    end
    if Options.ThemeManager_CardInner and preset.card_inner then
        Options.ThemeManager_CardInner:SetValueRGB(preset.card_inner)
    end
    if Options.ThemeManager_Border and preset.border then
        Options.ThemeManager_Border:SetValueRGB(preset.border)
    end
    if Options.ThemeManager_WindowTransparency and preset.window_transparency then
        Options.ThemeManager_WindowTransparency:SetValue(math.floor(preset.window_transparency * 100 + 0.5))
    end
    if Options.ThemeManager_PanelTransparency and preset.panel_transparency then
        Options.ThemeManager_PanelTransparency:SetValue(math.floor(preset.panel_transparency * 100 + 0.5))
    end
    if Options.ThemeManager_CardTransparency and preset.card_transparency then
        Options.ThemeManager_CardTransparency:SetValue(math.floor(preset.card_transparency * 100 + 0.5))
    end
end

