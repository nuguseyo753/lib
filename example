local SaveManager = {
    Folder = "Nuke Example",
    Ignore = {},
}

function SaveManager:SetLibrary(library)
    self.Library = library
end

function SaveManager:SetFolder(folder)
    self.Folder = folder or self.Folder
end

function SaveManager:IgnoreThemeSettings()
end

function SaveManager:SetIgnoreIndexes(indexes)
    self.Ignore = indexes or {}
end

function SaveManager:GetFolder()
    return (self.Folder or "Nuke Example") .. "/settings"
end

function SaveManager:BuildFolderTree()
    if not makefolder or not isfolder then
        return
    end
    if not isfolder(self.Folder) then
        makefolder(self.Folder)
    end
    if not isfolder(self:GetFolder()) then
        makefolder(self:GetFolder())
    end
end

function SaveManager:GetConfigPath(name)
    return self:GetFolder() .. "/" .. name .. ".cfg"
end

function SaveManager:GetSelectedConfig()
    local name = Options.SaveManager_ConfigName and Options.SaveManager_ConfigName.Value
    if type(name) == "string" then
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
    end

    if not name or name == "" then
        name = Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value
    end

    if type(name) ~= "string" or name == "" then
        return nil
    end

    return name:gsub("%.cfg$", "")
end

function SaveManager:RefreshConfigList()
    self:BuildFolderTree()
    if not listfiles then
        return {}
    end

    local ok, files = pcall(listfiles, self:GetFolder())
    if not ok or type(files) ~= "table" then
        return {}
    end

    local names = {}
    for _, file in ipairs(files) do
        local name = tostring(file):gsub("\\", "/"):match("([^/]+)%.cfg$")
        if name then
            table.insert(names, name)
        end
    end

    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)

    return names
end

function SaveManager:GetAutoloadConfig()
    if not isfile or not readfile then
        return nil
    end

    local path = self:GetFolder() .. "/autoload.txt"
    if not isfile(path) then
        return nil
    end

    local name = readfile(path)
    if type(name) == "string" then
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
    end

    return name ~= "" and name or nil
end

function SaveManager:UpdateList()
    if Options.SaveManager_ConfigList then
        Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
    end
end

function SaveManager:Save(name)
    name = name or self:GetSelectedConfig()
    if not name or not writefile then
        return
    end

    self:BuildFolderTree()
    writefile(self:GetConfigPath(name), Nuke:get_config())
    self:UpdateList()
end

function SaveManager:Load(name)
    name = name or self:GetSelectedConfig()
    if not name or not isfile or not readfile then
        return
    end

    local path = self:GetConfigPath(name)
    if isfile(path) then
        Nuke:load_config(readfile(path))
    end
end

function SaveManager:BuildConfigSection(tab)
    local group = tab:AddRightGroupbox("Configuration")
    local autoloadLabel

    group:AddInput("SaveManager_ConfigName", {
        Text = "Config name",
        Default = "",
    })

    group:AddDropdown("SaveManager_ConfigList", {
        Text = "Config list",
        Values = self:RefreshConfigList(),
        Default = nil,
    })

    group:AddButton({
        Text = "Create config",
        Func = function()
            self:Save()
        end,
    })

    group:AddButton({
        Text = "Load config",
        Func = function()
            self:Load()
        end,
    })

    group:AddButton({
        Text = "Overwrite config",
        Func = function()
            self:Save()
        end,
    })

    group:AddButton({
        Text = "Refresh list",
        Func = function()
            self:UpdateList()
        end,
    })

    group:AddButton({
        Text = "Set as autoload",
        Func = function()
            local name = self:GetSelectedConfig()
            if name and writefile then
                self:BuildFolderTree()
                writefile(self:GetFolder() .. "/autoload.txt", name)
                if autoloadLabel then
                    autoloadLabel:SetValue("Current autoload config: " .. name)
                end
            end
        end,
    })

    autoloadLabel = group:AddLabel("Current autoload config: " .. (self:GetAutoloadConfig() or "none"))
end

function SaveManager:LoadAutoloadConfig()
    local name = self:GetAutoloadConfig()
    if name then
        self:Load(name)
    end
end

