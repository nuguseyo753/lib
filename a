                Options = Options or {}
                return Section:AddInput(Options.Name or "Input", {
                    Default = Options.CurrentValue or Options.Default or "",
                    Placeholder = Options.PlaceholderText or Options.Placeholder or "",
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            function Section:CreateKeybind(Options)
                Options = Options or {}
                return Section:AddKeybind(Options.Name or "Keybind", {
                    Default = Options.CurrentKeybind or Options.Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                    Pressed = Options.Pressed,
