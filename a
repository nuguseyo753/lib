            function Section:CreateColorPicker(Options)
                Options = Options or {}
                return Section:AddColorPicker(Options.Name or "Color Picker", {
                    Default = Options.Color or Options.Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        function Tab:CreateSection(Title, Column)
            return Tab:AddSection(Title, Column)
        end

        addConnection(TopButton.MouseButton1Click:Connect(function()
            Tab:Show()
        end))

        addConnection(SideButton.MouseButton1Click:Connect(function()
            Tab:Show()
        end))

        addConnection(SideButton.MouseEnter:Connect(function()
            if Window.ActiveTab ~= Tab then
                tween(SideButton, { BackgroundTransparency = 0.78 }, 0.12)
            end
        end))

        addConnection(SideButton.MouseLeave:Connect(function()
            if Window.ActiveTab ~= Tab then
                tween(SideButton, { BackgroundTransparency = 1 }, 0.12)
            end
        end))

        table.insert(Window.Tabs, Tab)

        if #Window.Tabs == 1 then
            Tab:Show()
        end

        return Tab
    end

    function Window:CreateTab(Name, Icon)
        return Window:AddTab(Name, Icon)
    end

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Unload()
    for _, Connection in ipairs(Library.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    if table.clear then
        table.clear(Library.Connections)
    else
        for Index = #Library.Connections, 1, -1 do
            Library.Connections[Index] = nil
        end
    end
    ScreenGui:Destroy()
end

if getgenv then
    getgenv().MonoUI = Library
end

return Library
