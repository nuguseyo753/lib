        DockButton:Destroy()
    end))

    addConnection(UserInputService.InputBegan:Connect(function(Input, GameProcessed)
        if GameProcessed then
            return
        end

        if Input.KeyCode == Info.ToggleKey then
            setWindowVisible(not Window.Visible)
        end
    end))

    function Window:SetVisible(State)
        setWindowVisible(State)
    end

    function Window:Notify(Title, Content, Duration)
        return Library:Notify(Title, Content, Duration)
    end

    function Window:AddHeaderButton(Name, Callback)
        local Button = buttonBase(Name)
        Button.Size = UDim2.fromOffset(math.max(74, textSize(Name, Enum.Font.Gotham, 13).X + 22), 32)
        Button.Parent = HeaderActions

        addConnection(Button.MouseButton1Click:Connect(function()
            safeCallback(Callback, Window)
        end))

        table.insert(Window.HeaderButtons, Button)
        return Button
    end

    function Window:AddTab(Name, Icon)
        local Tab = {
            Name = Name,
            Icon = Icon,
            Sections = {},
            Columns = {},
            Pages = {},
            ActivePage = nil,
        }

        local SideButton = new("TextButton", {
            AutoButtonColor = false,
            BackgroundColor3 = Library.Theme.SurfaceLight,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 38),
            Text = "",
            Parent = SideList,
        }, {
            corner(5),
        })

        local ActiveRail = new("Frame", {
            BackgroundColor3 = Library.Theme.Text,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 7),
            Size = UDim2.fromOffset(3, 24),
            Visible = false,
            Parent = SideButton,
        }, {
            corner(2),
        })

        local SideIcon = iconLabel(Icon or string.lower(Name), 17)
        SideIcon.Position = UDim2.fromOffset(14, 0)
        SideIcon.Size = UDim2.fromOffset(22, 38)
        SideIcon.Parent = SideButton

        local SideText = label(Name, 13, Enum.FontWeight.Medium)
        SideText.Position = UDim2.fromOffset(48, 0)
        SideText.Size = UDim2.new(1, -54, 1, 0)
        SideText.TextColor3 = Library.Theme.MutedText
        SideText.Parent = SideButton

        local Page = new("ScrollingFrame", {
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarImageColor3 = Library.Theme.StrokeLight,
            ScrollBarThickness = 3,
            Size = UDim2.fromScale(1, 1),
            Visible = false,
            Parent = Pages,
        }, {
            padding(0, 0, 8, 0),
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 12),
            }),
        })

        for Index = 1, 3 do
            Tab.Columns[Index] = new("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Size = UDim2.new(1 / 3, -8, 0, 0),
                Parent = Page,
            }, {
                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 12),
                }),
            })
        end

        local DefaultPage = {
            Name = "Main",
            Button = nil,
            Frame = Page,
            Columns = Tab.Columns,
        }

        local function createTopPageButton(Text)
            local Button = new("TextButton", {
                AutoButtonColor = false,
                BackgroundColor3 = Library.Theme.SurfaceLight,
                BackgroundTransparency = 0.12,
                BorderSizePixel = 0,
                FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                Text = Text,
                TextColor3 = Library.Theme.MutedText,
                TextSize = 13,
                Size = UDim2.fromOffset(math.max(72, textSize(Text, Enum.Font.Gotham, 13).X + 24), 34),
                Visible = false,
                Parent = HeaderActions,
            }, {
                corner(7),
                stroke(Library.Theme.Stroke, 0.2, 1),
            })

            local Accent = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 1),
                BackgroundColor3 = Library.Theme.Accent,
                BorderSizePixel = 0,
                Position = UDim2.new(0.5, 0, 1, 3),
                Size = UDim2.new(1, -20, 0, 4),
                Visible = false,
                Parent = Button,
            }, {
                corner(999),
            })

            return Button, Accent
        end

        local function setPageActive(PageData, State)
            if PageData.Button then
                PageData.Button.Visible = Window.ActiveTab == Tab
                PageData.Button.TextColor3 = State and Library.Theme.Text or Library.Theme.MutedText
                PageData.Button.BackgroundTransparency = State and 0.02 or 0.3
                if PageData.Accent then
                    PageData.Accent.Visible = State
                end
            end

            PageData.Frame.Visible = State and Window.ActiveTab == Tab
        end

        local function showPage(PageData)
            for _, OtherPage in ipairs(Tab.Pages) do
                setPageActive(OtherPage, false)
            end

            Tab.ActivePage = PageData
            setPageActive(PageData, true)
        end

        function Tab:AddPage(PageName)
            local PageData

            if #Tab.Pages == 0 and #Tab.Sections == 0 then
                DefaultPage.Name = PageName or "Main"
                DefaultPage.Button, DefaultPage.Accent = createTopPageButton(DefaultPage.Name)
                PageData = DefaultPage
            else
                local PageFrame = new("ScrollingFrame", {
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.fromOffset(0, 0),
                    ScrollBarImageColor3 = Library.Theme.StrokeLight,
                    ScrollBarThickness = 3,
                    Size = UDim2.fromScale(1, 1),
                    Visible = false,
                    Parent = Pages,
                }, {
                    padding(0, 0, 8, 0),
                    new("UIListLayout", {
                        FillDirection = Enum.FillDirection.Horizontal,
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 12),
                    }),
                })

                local PageColumns = {}
                for Index = 1, 3 do
                    PageColumns[Index] = new("Frame", {
                        AutomaticSize = Enum.AutomaticSize.Y,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1 / 3, -8, 0, 0),
                        Parent = PageFrame,
                    }, {
                        new("UIListLayout", {
                            SortOrder = Enum.SortOrder.LayoutOrder,
                            Padding = UDim.new(0, 12),
                        }),
                    })
                end

                PageData = {
                    Name = PageName or ("Page " .. tostring(#Tab.Pages + 1)),
                    Frame = PageFrame,
                    Columns = PageColumns,
                }
                PageData.Button, PageData.Accent = createTopPageButton(PageData.Name)
            end

            function PageData:AddSection(Title, Column)
                local OriginalColumns = Tab.Columns
                Tab.Columns = PageData.Columns
                local Section = Tab:AddSection(Title, Column)
                Tab.Columns = OriginalColumns
                return Section
            end

            function PageData:section(Properties)
                Properties = Properties or {}
                return PageData:AddSection(Properties.name or Properties.Name or "Section", Properties.column or Properties.Column or Properties.side or Properties.Side or 1)
            end

            function PageData:Show()
                showPage(PageData)
            end

            addConnection(PageData.Button.MouseButton1Click:Connect(function()
                showPage(PageData)
            end))

            table.insert(Tab.Pages, PageData)

            if not Tab.ActivePage then
                Tab.ActivePage = PageData
            end

            return PageData
        end

        local function setActive(State)
            ActiveRail.Visible = State
            SideButton.BackgroundTransparency = State and 0.12 or 1
            SideText.TextColor3 = State and Library.Theme.Text or Library.Theme.MutedText

            if #Tab.Pages > 0 then
                if State then
                    for _, PageData in ipairs(Tab.Pages) do
                        setPageActive(PageData, false)
                    end
                    showPage(Tab.ActivePage or Tab.Pages[1])
                else
                    for _, PageData in ipairs(Tab.Pages) do
                        if PageData.Button then
                            PageData.Button.Visible = false
                        end
                        if PageData.Accent then
                            PageData.Accent.Visible = false
                        end
                        PageData.Frame.Visible = false
                    end
                end
            else
                Page.Visible = State
            end
        end

        function Tab:Show()
            for _, Other in ipairs(Window.Tabs) do
                Other:SetActive(false)
            end

            Window.ActiveTab = Tab
            Tab:SetActive(true)
        end

        function Tab:SetActive(State)
            setActive(State)
        end

        function Tab:AddSection(Title, Column)
            Column = math.clamp(Column or 1, 1, 3)

            local Section = {
                Title = Title,
            }

            local SectionFrame = panel({
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 0.08,
                Size = UDim2.new(1, 0, 0, 0),
                Parent = Tab.Columns[Column],
            })
            Section.Frame = SectionFrame

            local Header = new("Frame", {
                BackgroundColor3 = Library.Theme.Surface,
                BackgroundTransparency = 0.12,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 42),
                Parent = SectionFrame,
            })

            local HeaderText = label(Title, 14, Enum.FontWeight.SemiBold)
            HeaderText.Position = UDim2.fromOffset(16, 0)
            HeaderText.Size = UDim2.new(1, -32, 1, 0)
            HeaderText.Parent = Header

            new("Frame", {
                BackgroundColor3 = Library.Theme.Stroke,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 1, -1),
                Size = UDim2.new(1, 0, 0, 1),
                Parent = Header,
            })

            local Container = new("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(16, 54),
                Size = UDim2.new(1, -32, 0, 0),
                Parent = SectionFrame,
            }, {
                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 10),
                }),
                padding(0, 0, 0, 14),
            })

            SectionFrame.ChildAdded:Connect(function()
                task.defer(function()
                    SectionFrame.Size = UDim2.new(1, 0, 0, 54 + Container.AbsoluteSize.Y + 14)
                end)
            end)

            addConnection(Container:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                SectionFrame.Size = UDim2.new(1, 0, 0, 54 + Container.AbsoluteSize.Y + 14)
            end))

            Section.Container = Container

            function Section:AddToggle(Name, Options)
                return Library._createToggle(Container, Name, Options)
            end

            function Section:AddButton(Name, Options)
                return Library._createButton(Container, Name, Options)
            end

            function Section:AddSlider(Name, Options)
                return Library._createSlider(Container, Name, Options)
            end

            function Section:AddDropdown(Name, Options)
                return Library._createDropdown(Container, Name, Options)
            end

            function Section:AddInput(Name, Options)
                return Library._createInput(Container, Name, Options)
            end

            function Section:AddKeybind(Name, Options)
                return Library._createKeybind(Container, Name, Options)
            end

            function Section:AddColorPicker(Name, Options)
                return Library._createColorPicker(Container, Name, Options)
            end

            function Section:AddParagraph(Name, Content)
                return Library._createParagraph(Container, Name, Content)
            end

            function Section:AddEspPreview(Options)
                return Library._createEspPreview(Container, Options)
            end

            function Section:AddLabel(Text)
                local Row = addElementContainer(Container, 24)
                local Label = label(Text, 13)
                Label.TextColor3 = Library.Theme.MutedText
                Label.Size = UDim2.fromScale(1, 1)
                Label.Parent = Row
                return Label
            end

            function Section:toggle(Options)
                Options = Options or {}
                return Section:AddToggle(Options.name or Options.Name or "Toggle", {
                    Default = Options.default ~= nil and Options.default or Options.Default,
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                    Notify = Options.notify or Options.Notify,
                })
            end

            function Section:button(Options)
                Options = Options or {}
                return Section:AddButton(Options.name or Options.Name or "Button", Options.callback or Options.Callback)
            end

            function Section:slider(Options)
                Options = Options or {}
                return Section:AddSlider(Options.name or Options.Name or "Slider", {
                    Min = Options.min or Options.Min or 0,
                    Max = Options.max or Options.Max or 100,
                    Default = Options.default or Options.Default or 0,
                    Increment = Options.increment or Options.Increment,
                    Suffix = Options.suffix or Options.Suffix or "",
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                })
            end

            function Section:dropdown(Options)
                Options = Options or {}
                return Section:AddDropdown(Options.name or Options.Name or "Dropdown", {
                    Values = Options.options or Options.values or Options.Options or Options.Values or {},
                    Default = Options.default or Options.Default,
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                })
            end

            function Section:textbox(Options)
                Options = Options or {}
                return Section:AddInput(Options.name or Options.Name or "Textbox", {
                    Default = Options.default or Options.Default or "",
                    Placeholder = Options.placeholder or Options.Placeholder or "",
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                })
            end

            function Section:keybind(Options)
                Options = Options or {}
                return Section:AddKeybind(Options.name or Options.Name or "Keybind", {
                    Default = Options.default or Options.Default,
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                    Pressed = Options.pressed or Options.Pressed,
                })
            end

            function Section:colorpicker(Options)
                Options = Options or {}
                return Section:AddColorPicker(Options.name or Options.Name or "Color", {
                    Default = Options.default or Options.Default or Options.color or Options.Color,
                    Flag = Options.flag or Options.Flag,
                    Callback = Options.callback or Options.Callback,
                })
            end

            function Section:label(Options)
                Options = Options or {}
                return Section:AddLabel(Options.name or Options.Name or Options.text or Options.Text or "Label")
            end

            function Section:esp_preview(Options)
                return Section:AddEspPreview(Options)
            end

            function Section:CreateSection(Text)
                return Section:AddLabel(Text)
            end

            function Section:CreateButton(Options)
                Options = Options or {}
                return Section:AddButton(Options.Name or "Button", Options)
            end

            function Section:CreateToggle(Options)
                Options = Options or {}
                return Section:AddToggle(Options.Name or "Toggle", {
                    Default = Options.CurrentValue ~= nil and Options.CurrentValue or Options.Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            function Section:CreateSlider(Options)
                Options = Options or {}
                local Range = Options.Range or { Options.Min or 0, Options.Max or 100 }

                return Section:AddSlider(Options.Name or "Slider", {
                    Min = Range[1] or 0,
                    Max = Range[2] or 100,
                    Default = Options.CurrentValue ~= nil and Options.CurrentValue or Options.Default,
                    Rounding = Options.Rounding,
                    Increment = Options.Increment,
                    Suffix = Options.Suffix or "",
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            function Section:CreateDropdown(Options)
                Options = Options or {}
                local Default = Options.CurrentOption or Options.Default

                if typeof(Default) == "table" then
                    Default = Default[1]
                end

                return Section:AddDropdown(Options.Name or "Dropdown", {
                    Values = Options.Options or Options.Values or {},
                    Default = Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            function Section:CreateInput(Options)
                Options = Options or {}
                return Section:AddInput(Options.Name or "Input", {
                    Default = Options.CurrentValue or Options.Default or "",
                    Placeholder = Options.PlaceholderText or Options.Placeholder or "",
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            function Section:CreateKeybind(Options)
                Options = Options or {}
                return Section:AddKeybind(Options.Name or "Keybind", {
                    Default = Options.CurrentKeybind or Options.Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                    Pressed = Options.Pressed,
                })
            end

            function Section:CreateColorPicker(Options)
                Options = Options or {}
                return Section:AddColorPicker(Options.Name or "Color Picker", {
                    Default = Options.Color or Options.Default,
                    Flag = Options.Flag,
                    Callback = Options.Callback,
                })
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        function Tab:CreateSection(Title, Column)
            return Tab:AddSection(Title, Column)
        end

        addConnection(SideButton.MouseButton1Click:Connect(function()
            Tab:Show()
        end))

        addConnection(SideButton.MouseEnter:Connect(function()
            if Window.ActiveTab ~= Tab then
                tween(SideButton, { BackgroundTransparency = 0.78 }, 0.12)
            end
        end))

        addConnection(SideButton.MouseLeave:Connect(function()
            if Window.ActiveTab ~= Tab then
                tween(SideButton, { BackgroundTransparency = 1 }, 0.12)
            end
        end))

        table.insert(Window.Tabs, Tab)

        if #Window.Tabs == 1 then
            Tab:Show()
        end

        return Tab
    end

    function Window:CreateTab(Name, Icon)
        return Window:AddTab(Name, Icon)
    end

    function Window:tab(Properties)
        Properties = Properties or {}
        local Tab = Window:AddTab(Properties.name or Properties.Name or "Tab", Properties.icon or Properties.Icon)
        local Names = Properties.tabs or Properties.Tabs or { "Main", "Misc", "Settings" }
        local PagesOut = {}

        for _, PageName in ipairs(Names) do
            table.insert(PagesOut, Tab:AddPage(PageName))
        end

        return table.unpack(PagesOut)
    end

    function Window:CreateHeaderButton(Name, Callback)
        return Window:AddHeaderButton(Name, Callback)
    end

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Unload()
    for _, Connection in ipairs(Library.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    if table.clear then
        table.clear(Library.Connections)
    else
        for Index = #Library.Connections, 1, -1 do
            Library.Connections[Index] = nil
        end
    end
    ScreenGui:Destroy()
end

if getgenv then
    getgenv().MonoUI = Library
end

return Library


