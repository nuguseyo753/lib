--[[
    MONO UI
    A monochrome Roblox/Luau UI library inspired by compact glass panels.

    Example:

    local Mono = loadstring(game:HttpGet(".../Mono UI.luau"))()
    local Window = Mono:CreateWindow({ Title = "MONO UI", Size = UDim2.fromOffset(760, 480) })
    local Main = Window:AddTab("Main", "home")
    local General = Main:AddSection("General", 1)

    General:AddToggle("Enable", { Default = true, Callback = function(Value) print(Value) end })
    General:AddSlider("FOV", { Min = 30, Max = 200, Default = 120, Callback = function(Value) print(Value) end })
    General:AddButton("Save Config", function() Mono:Notify("Config", "Saved") end)
]]

