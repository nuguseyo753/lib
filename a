    ContentLabel.TextColor3 = Library.Theme.MutedText
    ContentLabel.TextWrapped = true
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
    ContentLabel.Position = UDim2.fromOffset(78, 52)
    ContentLabel.Size = UDim2.new(1, -116, 0, 40)
    ContentLabel.Parent = Modal

    local Close = new("TextButton", {
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json"),
        Text = Icons.close,
        TextColor3 = Library.Theme.Text,
        TextSize = 22,
        Position = UDim2.new(1, -38, 0, 15),
        Size = UDim2.fromOffset(24, 24),
        Parent = Modal,
    })

    local Cancel = buttonBase(Info.Cancel)
    Cancel.Position = UDim2.new(0, 58, 1, -48)
    Cancel.Size = UDim2.fromOffset(122, 34)
    Cancel.Parent = Modal

    local Confirm = buttonBase(Info.Confirm)
    Confirm.BackgroundColor3 = Library.Theme.Text
    Confirm.TextColor3 = Library.Theme.AccentDark
    Confirm.Position = UDim2.new(1, -158, 1, -48)
    Confirm.Size = UDim2.fromOffset(132, 34)
