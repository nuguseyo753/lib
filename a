function Library._createToggle(Parent, Name, Info)
    Info = normalizeInfo(Info, { Default = false })

    local Toggle = {
        Value = Info.Default and true or false,
    }

    local Row = addElementContainer(Parent, 32)
    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, -56, 1, 0)
    TextLabel.Parent = Row

    local Track = new("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = Toggle.Value and Library.Theme.Text or Library.Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -39, 0.5, -10),
        Size = UDim2.fromOffset(39, 20),
        Text = "",
        Parent = Row,
    }, {
        corner(10),
        stroke(Library.Theme.StrokeLight, 0.25, 1),
    })

    local Knob = new("Frame", {
        BackgroundColor3 = Toggle.Value and Library.Theme.AccentDark or Library.Theme.StrokeLight,
        BorderSizePixel = 0,
        Position = Toggle.Value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(14, 14),
        Parent = Track,
    }, {
        corner(7),
    })

    function Toggle:Set(Value)
        Toggle.Value = Value and true or false
        Library.Flags[Info.Flag or Name] = Toggle.Value

        tween(Track, { BackgroundColor3 = Toggle.Value and Library.Theme.Text or Library.Theme.Background }, 0.14)
        tween(Knob, {
            BackgroundColor3 = Toggle.Value and Library.Theme.AccentDark or Library.Theme.StrokeLight,
            Position = Toggle.Value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
        }, 0.14)

        safeCallback(Info.Callback, Toggle.Value)
    end

    addConnection(Track.MouseButton1Click:Connect(function()
        Toggle:Set(not Toggle.Value)
    end))

    Toggle:Set(Toggle.Value)
    Library.Options[Info.Flag or Name] = Toggle
    return Toggle
end

function Library._createButton(Parent, Name, Info)
    Info = normalizeInfo(Info)

    local Button = buttonBase(Name)
    Button.Size = UDim2.new(1, 0, 0, 34)
