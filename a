        new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
        }),
    })

    local Badge = panel({
        BackgroundColor3 = Library.Theme.Surface,
        BackgroundTransparency = 0.08,
        Position = UDim2.new(0, 16, 1, -96),
        Size = UDim2.new(1, -32, 0, 76),
        Parent = Sidebar,
    })

