function Library:RegisterThemePreset(Name, Theme)
    if type(Name) ~= "string" or type(Theme) ~= "table" then
        return false
    end

    Theme.Name = Theme.Name or Name
    Library.ThemePresets[Name] = Theme
    return true
end

function Library:SetThemePreset(Name)
    local Preset = Library.ThemePresets[Name]
    if not Preset then
        return false
    end

    for Key, Value in pairs(Preset) do
        if Key ~= "Name" then
            Library.Theme[Key] = Value
        end
    end

    Library.Runtime.ThemePreset = Name
    return true
end

function Library:GetThemePreset(Name)
    return Library.ThemePresets[Name or Library.Runtime.ThemePreset]
end

function Library:RegisterFlag(Flag, DefaultValue)
    if type(Flag) ~= "string" then
        return
    end

    if Library.Flags[Flag] == nil then
        Library.Flags[Flag] = DefaultValue
    end

    Library.Runtime.RegisteredFlags[Flag] = true
    return Library.Flags[Flag]
end

function Library:SetFlag(Flag, Value)
    if type(Flag) ~= "string" then
        return false
    end

    Library.Flags[Flag] = Value

    local Option = Library.Options[Flag]
    if Option and type(Option.Set) == "function" then
        safeCallback(function() Option:Set(Value) end)
    end

    return true
end

function Library:GetFlag(Flag, Fallback)
    if Library.Flags[Flag] == nil then
        return Fallback
    end

    return Library.Flags[Flag]
end

function Library:GetAllFlags()
    local Copy = {}
    for Flag, Value in pairs(Library.Flags) do
        Copy[Flag] = Value
    end
    return Copy
end

function Library:ResetFlags()
    for Flag in pairs(Library.Flags) do
        Library.Flags[Flag] = nil
    end
end

function Library:RegisterLayout(Id, Data)
    if type(Id) ~= "string" or type(Data) ~= "table" then
        return false
    end

    Library.Runtime.LayoutRegistry[Id] = Data
    return true
end

function Library:GetLayout(Id)
    return Library.Runtime.LayoutRegistry[Id] or Library.LayoutPresets[Id]
end

function Library:BindToWindowVisibility(Callback)
    if type(Callback) ~= "function" then
        return
    end

    table.insert(Library.Runtime.WindowBindings, Callback)
end

function Library:_FireWindowVisibility(State)
    for _, Callback in ipairs(Library.Runtime.WindowBindings) do
        safeCallback(Callback, State)
    end
end

function Library:CreateWatermark(Info)
    Info = normalizeInfo(Info, { Text = "MONO UI", Position = UDim2.fromOffset(20, 20), Visible = true })

    local Mark = panel({
        BackgroundTransparency = 0.04,
        Position = Info.Position,
        Size = UDim2.fromOffset(math.max(120, textSize(Info.Text, Enum.Font.Gotham, 13).X + 34), 34),
        Visible = Info.Visible and true or false,
        Parent = ScreenGui,
    })

    local Text = label(Info.Text, 13, Enum.FontWeight.SemiBold)
    Text.TextXAlignment = Enum.TextXAlignment.Center
    Text.Size = UDim2.fromScale(1, 1)
    Text.Parent = Mark

    local Object = { Frame = Mark, Label = Text }
    function Object:Set(TextValue)
        Text.Text = tostring(TextValue)
        Mark.Size = UDim2.fromOffset(math.max(120, textSize(Text.Text, Enum.Font.Gotham, 13).X + 34), 34)
    end
    function Object:SetVisible(State)
        Mark.Visible = State and true or false
    end
    function Object:Destroy()
        Mark:Destroy()
    end
    return Object
end

function Library:CreateKeybindList(Info)
    Info = normalizeInfo(Info, { Title = "Keybinds", Position = UDim2.fromOffset(20, 64), Visible = false })
    local PanelObject = Library:CreateFloatingPanel({
        Title = Info.Title,
        Icon = "keybind",
        Position = Info.Position,
        Size = UDim2.fromOffset(245, 260),
        Visible = Info.Visible,
    })

    PanelObject.Rows = {}
    function PanelObject:AddBind(Name, Key)
        local Row = PanelObject:AddText(Name, typeof(Key) == "EnumItem" and Key.Name or tostring(Key))
        PanelObject.Rows[Name] = Row
        return Row
    end
    function PanelObject:SetBind(Name, Key)
        if PanelObject.Rows[Name] then
            PanelObject.Rows[Name]:Set(typeof(Key) == "EnumItem" and Key.Name or tostring(Key))
        else
            PanelObject:AddBind(Name, Key)
        end
    end
    return PanelObject
end

function Library:CreateCommandPalette(Info)
    Info = normalizeInfo(Info, { Title = "Command Palette", Position = UDim2.fromScale(0.5, 0.2), Visible = false })
    local Palette = Library:CreateFloatingPanel({
        Title = Info.Title,
        Icon = "terminal",
        Position = Info.Position,
        Size = UDim2.fromOffset(360, 320),
        Visible = Info.Visible,
    })
    Palette.Commands = {}
    function Palette:AddCommand(Name, Callback)
        Palette.Commands[Name] = Callback
        return Palette:AddToggle(Name, { Default = false, Callback = function(Value) if Value then safeCallback(Callback, Palette) end end })
    end
    function Palette:Run(Name)
        safeCallback(Palette.Commands[Name], Palette)
    end
    return Palette
end

function Library:BuildSectionFromRecipe(Section, RecipeKey)
    local Recipe = Library.WidgetCatalog[RecipeKey]
    if not Recipe or type(Section) ~= "table" then
        return
    end

    if Recipe.Type == "Toggle" and Section.AddToggle then
        return Section:AddToggle(Recipe.Name, { Flag = Recipe.Flag, Default = Recipe.Default })
    elseif Recipe.Type == "Slider" and Section.AddSlider then
        return Section:AddSlider(Recipe.Name, { Flag = Recipe.Flag, Min = Recipe.Min, Max = Recipe.Max, Increment = Recipe.Increment, Default = Recipe.Min })
    elseif Recipe.Type == "Dropdown" and Section.AddDropdown then
        return Section:AddDropdown(Recipe.Name, { Flag = Recipe.Flag, Values = Recipe.Values, Default = Recipe.Values[1] })
    elseif Recipe.Type == "Button" and Section.AddButton then
        return Section:AddButton(Recipe.Name, function() Library:Notify("Recipe", Recipe.Name, 2) end)
    elseif Recipe.Type == "Input" and Section.AddInput then
        return Section:AddInput(Recipe.Name, { Flag = Recipe.Flag, Default = "" })
    elseif Recipe.Type == "Keybind" and Section.AddKeybind then
        return Section:AddKeybind(Recipe.Name, { Flag = Recipe.Flag, Default = Enum.KeyCode.Insert })
    elseif Recipe.Type == "ColorPicker" and Section.AddColorPicker then
        return Section:AddColorPicker(Recipe.Name, { Flag = Recipe.Flag, Default = Color3.fromRGB(242, 242, 242) })
    elseif Recipe.Type == "Paragraph" and Section.AddParagraph then
        return Section:AddParagraph(Recipe.Name, "Generated recipe paragraph.")
    elseif Section.AddLabel then
        return Section:AddLabel(Recipe.Name)
    end
end

function Library:GetRecipesByCategory(Category)
    local Results = {}
    for Key, Recipe in pairs(Library.WidgetCatalog) do
        if Recipe.Category == Category then
            table.insert(Results, Key)
        end
    end
    table.sort(Results)
    return Results
end

function Library:GetRecipesByType(TypeName)
    local Results = {}
    for Key, Recipe in pairs(Library.WidgetCatalog) do
        if Recipe.Type == TypeName then
            table.insert(Results, Key)
        end
    end
    table.sort(Results)
    return Results
end
