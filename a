function Library:CreateWindow(Info)
    Info = normalizeInfo(Info, {
        Title = "MONO UI",
        Subtitle = "Premium Edition",
        Version = Library.Version,
        Size = UDim2.fromOffset(760, 480),
        Position = UDim2.fromScale(0.5, 0.5),
