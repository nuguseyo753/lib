--[[
    Astra Interface
    A Millenium-inspired Roblox/Luau UI library with Nhack-style reactive widgets.

    Example:

    local UI = loadstring(game:HttpGet(".../library.lua"))()
    local Window = UI:CreateWindow({ Name = "Astra", Size = UDim2.fromOffset(790, 510) })
    local Main, Misc, Settings = Window:tab({ name = "Combat", tabs = { "Main", "Misc", "Settings" } })
    local General = Main:section({ name = "General", side = 1 })

    General:AddToggle("Enable", { Default = true, Callback = function(Value) print(Value) end })
    General:AddSlider("FOV", { Min = 30, Max = 200, Default = 120, Callback = function(Value) print(Value) end })
    General:button({ name = "Save Config", callback = function() UI:Notify("Config", "Saved") end })
]]

