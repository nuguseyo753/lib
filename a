function Library._createInput(Parent, Name, Info)
    Info = normalizeInfo(Info, { Placeholder = "", Default = "" })

    local InputObject = {
        Value = Info.Default,
    }

    local Row = addElementContainer(Parent, 62)
    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, 0, 0, 22)
    TextLabel.Parent = Row

    local Box = new("TextBox", {
        BackgroundColor3 = Library.Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json"),
        PlaceholderColor3 = Library.Theme.FaintText,
        PlaceholderText = Info.Placeholder,
        Position = UDim2.fromOffset(0, 28),
        Size = UDim2.new(1, 0, 0, 32),
        Text = tostring(Info.Default),
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        Parent = Row,
    }, {
        corner(5),
        stroke(Library.Theme.Stroke, 0.18, 1),
        padding(10, 0, 10, 0),
    })

    function InputObject:Set(Value)
        InputObject.Value = tostring(Value)
        Box.Text = InputObject.Value
        Library.Flags[Info.Flag or Name] = InputObject.Value
        safeCallback(Info.Callback, InputObject.Value)
    end

    addConnection(Box.FocusLost:Connect(function()
        InputObject:Set(Box.Text)
    end))

    Library.Options[Info.Flag or Name] = InputObject
    return InputObject
end

function Library._createSlider(Parent, Name, Info)
    Info = normalizeInfo(Info, { Min = 0, Max = 100, Default = 0, Rounding = nil, Suffix = "", Increment = nil })

    local Slider = {
        Min = Info.Min,
        Max = Info.Max,
        Value = Info.Default,
    }

    local Dragging = false
    local Row = addElementContainer(Parent, 62)

    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, -58, 0, 24)
    TextLabel.Parent = Row

    local ValueBox = panel({
        BackgroundColor3 = Library.Theme.Background,
        BackgroundTransparency = 0.05,
        Position = UDim2.new(1, -52, 0, 0),
        Size = UDim2.fromOffset(52, 28),
        Parent = Row,
    })

    local ValueLabel = label("", 13, Enum.FontWeight.Medium)
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Center
    ValueLabel.Size = UDim2.fromScale(1, 1)
    ValueLabel.Parent = ValueBox

    local BarBack = new("Frame", {
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 43),
        Size = UDim2.new(1, 0, 0, 4),
        Parent = Row,
    }, {
        corner(2),
    })

    local BarFill = new("Frame", {
        BackgroundColor3 = Library.Theme.Text,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = BarBack,
    }, {
        corner(2),
    })

    local Knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Library.Theme.Text,
        BorderSizePixel = 0,
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(14, 14),
        Parent = BarBack,
    }, {
        corner(7),
    })

    local Hitbox = new("TextButton", {
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 31),
        Size = UDim2.new(1, 0, 0, 28),
        Text = "",
        Parent = Row,
    })

    local function round(Value)
        if Info.Increment and Info.Increment > 0 then
            Value = Slider.Min + (math.floor(((Value - Slider.Min) / Info.Increment) + 0.5) * Info.Increment)
        end

        local Rounding = Info.Rounding
        if Rounding == nil then
            local IncrementText = tostring(Info.Increment or "")
            local Decimal = IncrementText:match("%.(%d+)")
            Rounding = Decimal and #Decimal or 0
        end

        if Rounding <= 0 then
            return math.floor(Value + 0.5)
        end

        local Multiplier = 10 ^ Rounding
        return math.floor(Value * Multiplier + 0.5) / Multiplier
    end

    local function updateFromPosition(X)
        local Percent = math.clamp((X - BarBack.AbsolutePosition.X) / BarBack.AbsoluteSize.X, 0, 1)
        Slider:Set(Slider.Min + (Slider.Max - Slider.Min) * Percent)
    end

    function Slider:Set(Value)
        Value = math.clamp(round(Value), Slider.Min, Slider.Max)
        Slider.Value = Value
        Library.Flags[Info.Flag or Name] = Value

        local Percent = (Value - Slider.Min) / (Slider.Max - Slider.Min)
        ValueLabel.Text = tostring(Value) .. (Info.Suffix or "")
        BarFill.Size = UDim2.new(Percent, 0, 1, 0)
        Knob.Position = UDim2.fromScale(Percent, 0.5)

        safeCallback(Info.Callback, Value)
    end

    addConnection(Hitbox.MouseButton1Down:Connect(function(X)
        Dragging = true
        updateFromPosition(X)
    end))

    addConnection(UserInputService.InputChanged:Connect(function(Input)
        if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromPosition(Input.Position.X)
        end
    end))

    addConnection(UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end))

    Slider:Set(Info.Default)
    Library.Options[Info.Flag or Name] = Slider
    return Slider
end

function Library._createDropdown(Parent, Name, Info)
    Info = normalizeInfo(Info, { Values = {}, Default = nil })

    local Dropdown = {
        Values = Info.Values,
        Value = Info.Default,
        Open = false,
    }

    local Row = addElementContainer(Parent, 72)
    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, 0, 0, 22)
    TextLabel.Parent = Row

    local Button = buttonBase("")
    Button.Position = UDim2.fromOffset(0, 28)
    Button.Size = UDim2.new(1, 0, 0, 34)
    Button.Text = ""
    Button.Parent = Row

    local Selected = label("", 13)
    Selected.TextColor3 = Library.Theme.MutedText
    Selected.Position = UDim2.fromOffset(12, 0)
    Selected.Size = UDim2.new(1, -42, 1, 0)
    Selected.Parent = Button

    local Arrow = label("v", 16, Enum.FontWeight.Medium)
    Arrow.TextXAlignment = Enum.TextXAlignment.Center
    Arrow.Position = UDim2.new(1, -30, 0, 0)
    Arrow.Size = UDim2.fromOffset(26, 34)
    Arrow.Parent = Button

    local List = panel({
        BackgroundColor3 = Library.Theme.SurfaceLight,
        BackgroundTransparency = 0.02,
        Position = UDim2.fromOffset(0, 66),
        Size = UDim2.new(1, 0, 0, 0),
        Parent = Row,
        Visible = false,
        ZIndex = 40,
    }, {
        new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })

    local function resizeList()
        Row.Size = Dropdown.Open and UDim2.new(1, 0, 0, 72 + (#Dropdown.Values * 30)) or UDim2.new(1, 0, 0, 72)
        List.Size = Dropdown.Open and UDim2.new(1, 0, 0, #Dropdown.Values * 30) or UDim2.new(1, 0, 0, 0)
        List.Visible = Dropdown.Open
    Arrow.Text = Dropdown.Open and "^" or "v"
    end

    function Dropdown:Set(Value)
        Dropdown.Value = Value
        Selected.Text = Value and tostring(Value) or "Select an option"
        Library.Flags[Info.Flag or Name] = Value
        safeCallback(Info.Callback, Value)
    end

    for _, Value in ipairs(Dropdown.Values) do
        local Option = new("TextButton", {
            AutoButtonColor = false,
            BackgroundColor3 = Library.Theme.SurfaceLight,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json"),
            Text = tostring(Value),
            TextColor3 = Library.Theme.Text,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, 0, 0, 30),
            ZIndex = 42,
            Parent = List,
        }, {
            padding(12, 0, 12, 0),
        })

        addConnection(Option.MouseEnter:Connect(function()
            tween(Option, { BackgroundTransparency = 0 }, 0.12)
        end))

        addConnection(Option.MouseLeave:Connect(function()
            tween(Option, { BackgroundTransparency = 1 }, 0.12)
        end))

        addConnection(Option.MouseButton1Click:Connect(function()
            Dropdown:Set(Value)
            Dropdown.Open = false
            resizeList()
        end))
    end

    addConnection(Button.MouseButton1Click:Connect(function()
        Dropdown.Open = not Dropdown.Open
        resizeList()
    end))

    Dropdown:Set(Info.Default)
    resizeList()
    Library.Options[Info.Flag or Name] = Dropdown
    return Dropdown
end

function Library._createKeybind(Parent, Name, Info)
    Info = normalizeInfo(Info, { Default = Enum.KeyCode.Insert })

    local Bind = {
        Value = Info.Default,
        Listening = false,
    }

    local Row = addElementContainer(Parent, 62)
    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, 0, 0, 22)
    TextLabel.Parent = Row

    local Button = buttonBase("")
    Button.Position = UDim2.fromOffset(0, 28)
    Button.Size = UDim2.new(1, -42, 0, 34)
    Button.Parent = Row

    local More = buttonBase("...")
    More.Position = UDim2.new(1, -36, 0, 28)
    More.Size = UDim2.fromOffset(36, 34)
    More.Parent = Row

    function Bind:Set(Key)
        Bind.Value = Key
        Button.Text = typeof(Key) == "EnumItem" and Key.Name or tostring(Key)
        Library.Flags[Info.Flag or Name] = Bind.Value
        safeCallback(Info.Callback, Bind.Value)
    end

    addConnection(Button.MouseButton1Click:Connect(function()
        Bind.Listening = true
        Button.Text = "..."
    end))

    addConnection(UserInputService.InputBegan:Connect(function(Input, GameProcessed)
        if GameProcessed then
            return
        end

        if Bind.Listening then
            Bind.Listening = false
            Bind:Set(Input.KeyCode ~= Enum.KeyCode.Unknown and Input.KeyCode or Input.UserInputType)
            return
        end

        if Input.KeyCode == Bind.Value then
            safeCallback(Info.Pressed)
        end
    end))

    Bind:Set(Info.Default)
    Library.Options[Info.Flag or Name] = Bind
    return Bind
end

function Library._createColorPicker(Parent, Name, Info)
    Info = normalizeInfo(Info, { Default = Color3.fromRGB(242, 242, 240) })

    local Picker = {
        Value = Info.Default,
    }

    local Row = addElementContainer(Parent, 48)
    local TextLabel = label(Name, 13)
    TextLabel.Size = UDim2.new(1, -46, 1, 0)
    TextLabel.Parent = Row

    local Swatch = new("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = Picker.Value,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -34, 0.5, -13),
        Size = UDim2.fromOffset(28, 26),
        Text = "",
        Parent = Row,
    }, {
        corner(4),
        stroke(Library.Theme.Text, 0.1, 1),
    })

    function Picker:Set(Color)
        Picker.Value = Color
        Swatch.BackgroundColor3 = Color
        Library.Flags[Info.Flag or Name] = Color
        safeCallback(Info.Callback, Color)
    end

    addConnection(Swatch.MouseButton1Click:Connect(function()
        local Floating = Library:CreateFloatingPanel({
            Title = Name,
            Icon = "color",
            Position = UDim2.fromOffset(44, 450),
            Size = UDim2.fromOffset(235, 214),
        })

        local Preview = new("Frame", {
            BackgroundColor3 = Picker.Value,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 84),
            Parent = Floating.Container,
        }, {
            corner(5),
            stroke(Library.Theme.Stroke, 0.18, 1),
        })

        local Hex = Library._createInput(Floating.Container, "HEX", {
            Default = "#" .. Picker.Value:ToHex(),
            Callback = function(Value)
                local Clean = tostring(Value):gsub("#", "")
                if #Clean == 6 then
                    local Success, Color = pcall(Color3.fromHex, Clean)
                    if Success then
                        Preview.BackgroundColor3 = Color
                        Picker:Set(Color)
                    end
                end
            end,
        })

        Hex:Set("#" .. Picker.Value:ToHex())
    end))

    Picker:Set(Picker.Value)
    Library.Options[Info.Flag or Name] = Picker
    return Picker
end

function Library._createParagraph(Parent, Name, Content)
    local Row = addElementContainer(Parent)
    local TitleLabel = label(Name, 13, Enum.FontWeight.SemiBold)
    TitleLabel.Size = UDim2.new(1, 0, 0, 20)
    TitleLabel.Parent = Row

    local ContentLabel = label(Content or "", 12, Enum.FontWeight.Regular)
    ContentLabel.AutomaticSize = Enum.AutomaticSize.Y
    ContentLabel.TextColor3 = Library.Theme.MutedText
    ContentLabel.TextWrapped = true
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
    ContentLabel.Position = UDim2.fromOffset(0, 24)
    ContentLabel.Size = UDim2.new(1, 0, 0, 0)
    ContentLabel.Parent = Row

    local Bounds = textSize(Content or "", Enum.Font.Gotham, 12)
    Row.Size = UDim2.new(1, 0, 0, math.max(48, Bounds.Y + 32))

    return ContentLabel
end

