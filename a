local function addConnection(Connection)
    table.insert(Library.Connections, Connection)
    return Connection
end

local function safeCallback(Callback, ...)
    if not Callback then
        return
    end

    local Success, Result = pcall(Callback, ...)
    if not Success then
        warn("[MONO UI] callback error:", Result)
    end
end

local function tween(InstanceObject, Properties, Time, Style, Direction)
    local Info = TweenInfo.new(Time or 0.16, Style or Enum.EasingStyle.Quad, Direction or Enum.EasingDirection.Out)
    local Tween = TweenService:Create(InstanceObject, Info, Properties)
    Tween:Play()
    return Tween
end

local function new(ClassName, Properties, Children)
    local Object = Instance.new(ClassName)

    for Key, Value in pairs(Properties or {}) do
        Object[Key] = Value
    end

    for _, Child in ipairs(Children or {}) do
        Child.Parent = Object
    end

    return Object
end

local function corner(Radius)
    return new("UICorner", {
        CornerRadius = UDim.new(0, Radius or 6),
    })
end

local function stroke(Color, Transparency, Thickness)
    return new("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = Color or Library.Theme.Stroke,
        Transparency = Transparency or 0,
        Thickness = Thickness or 1,
    })
end

local function padding(Left, Top, Right, Bottom)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, Left or 0),
        PaddingTop = UDim.new(0, Top or 0),
        PaddingRight = UDim.new(0, Right or Left or 0),
        PaddingBottom = UDim.new(0, Bottom or Top or 0),
    })
end

local function textSize(Text, Font, Size)
    return TextService:GetTextSize(tostring(Text), Size or 13, Font or Enum.Font.Gotham, Vector2.new(1000, 1000))
end

local function makeDraggable(Handle, Target)
    local Dragging = false
    local DragStart
    local StartPosition

    addConnection(Handle.InputBegan:Connect(function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        Dragging = true
        DragStart = Input.Position
        StartPosition = Target.Position

        local EndConnection
        EndConnection = Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
                if EndConnection then
                    EndConnection:Disconnect()
                end
            end
        end)
    end))

    addConnection(UserInputService.InputChanged:Connect(function(Input)
        if not Dragging or Input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        local Delta = Input.Position - DragStart
        Target.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end))
end

local function label(Text, Size, Weight)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Weight or Enum.FontWeight.Regular, Enum.FontStyle.Normal),
        Text = Text or "",
        TextColor3 = Library.Theme.Text,
        TextSize = Size or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    })
end

local function iconLabel(Icon, Size)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold, Enum.FontStyle.Normal),
        Text = Icons[Icon] or Icon or "",
        TextColor3 = Library.Theme.Text,
        TextSize = Size or 16,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
    })
end

local function panel(Properties, Children)
    Properties = Properties or {}
    local Radius = Properties.Radius or 6
    local StrokeColor = Properties.StrokeColor or Library.Theme.Stroke
    local StrokeTransparency = Properties.StrokeTransparency or 0.25

    Properties.Radius = nil
    Properties.StrokeColor = nil
    Properties.StrokeTransparency = nil

    Properties.BackgroundColor3 = Properties.BackgroundColor3 or Library.Theme.Surface
    Properties.BackgroundTransparency = Properties.BackgroundTransparency or 0.08
    Properties.BorderSizePixel = 0
    Properties.ClipsDescendants = Properties.ClipsDescendants == nil and true or Properties.ClipsDescendants

    local Frame = new("Frame", Properties, Children)
    corner(Radius).Parent = Frame
    stroke(StrokeColor, StrokeTransparency, 1).Parent = Frame
    return Frame
end

local function buttonBase(Text)
    local Button = new("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = Library.Theme.SurfaceLight,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
        Text = Text or "",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, {
        corner(5),
        stroke(Library.Theme.Stroke, 0.18, 1),
    })

    addConnection(Button.MouseEnter:Connect(function()
        tween(Button, { BackgroundColor3 = Library.Theme.SurfaceHover }, 0.12)
    end))

    addConnection(Button.MouseLeave:Connect(function()
        tween(Button, { BackgroundColor3 = Library.Theme.SurfaceLight }, 0.12)
    end))

    return Button
end

local function addElementContainer(Parent, Height)
    return new("Frame", {
        AutomaticSize = Height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Size = Height and UDim2.new(1, 0, 0, Height) or UDim2.new(1, 0, 0, 0),
        Parent = Parent,
    })
end

local function normalizeInfo(Info, Defaults)
    if typeof(Info) == "function" then
        Info = { Callback = Info }
    elseif typeof(Info) ~= "table" then
        Info = {}
    end

    for Key, Value in pairs(Defaults or {}) do
        if Info[Key] == nil then
            Info[Key] = Value
        end
    end

    return Info
end

function Library:Notify(Title, Content, Duration)
    if typeof(Title) == "table" then
        Content = Title.Content or Title.Description or ""
        Duration = Title.Duration
        Title = Title.Title or "Notification"
    end

    Duration = Duration or 3

    if not Library.NotificationHolder then
        Library.NotificationHolder = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 1),
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, 0, 1, -28),
            Size = UDim2.fromOffset(430, 220),
            Parent = ScreenGui,
        }, {
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Vertical,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                SortOrder = Enum.SortOrder.LayoutOrder,
                VerticalAlignment = Enum.VerticalAlignment.Bottom,
                Padding = UDim.new(0, 10),
            }),
        })
    end

    local Holder = panel({
        BackgroundTransparency = 0.02,
        Size = UDim2.fromOffset(410, 82),
        Parent = Library.NotificationHolder,
    })

    Holder.Position = UDim2.fromOffset(0, 22)
    Holder.BackgroundTransparency = 1
    Holder.UIStroke.Transparency = 1

    local Check = iconLabel("check", 25)
    Check.Size = UDim2.fromOffset(46, 46)
    Check.Position = UDim2.fromOffset(20, 18)
    Check.Parent = Holder
    stroke(Library.Theme.Text, 0, 2).Parent = Check
    corner(23).Parent = Check

    local TitleLabel = label(Title or "Notification", 15, Enum.FontWeight.SemiBold)
    TitleLabel.Position = UDim2.fromOffset(84, 18)
    TitleLabel.Size = UDim2.new(1, -126, 0, 22)
    TitleLabel.Parent = Holder

    local ContentLabel = label(Content or "", 13, Enum.FontWeight.Regular)
    ContentLabel.TextColor3 = Library.Theme.MutedText
    ContentLabel.Position = UDim2.fromOffset(84, 43)
    ContentLabel.Size = UDim2.new(1, -126, 0, 20)
    ContentLabel.Parent = Holder

    local Close = new("TextButton", {
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
        Text = Icons.close,
        TextColor3 = Library.Theme.Text,
        TextSize = 22,
        Position = UDim2.new(1, -36, 0, 17),
        Size = UDim2.fromOffset(24, 24),
        Parent = Holder,
    })

    local Bar = new("Frame", {
        BackgroundColor3 = Library.Theme.Text,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(20, 72),
        Size = UDim2.new(1, -40, 0, 3),
        Parent = Holder,
    }, {
        corner(2),
    })

    local Closed = false
    local function closeNotification()
        if Closed then
            return
        end

        Closed = true
        tween(Holder, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 22) }, 0.22)
        tween(Holder.UIStroke, { Transparency = 1 }, 0.22)
        task.delay(0.24, function()
            Holder:Destroy()
        end)
    end

    addConnection(Close.MouseButton1Click:Connect(closeNotification))

    tween(Holder, { BackgroundTransparency = 0.02, Position = UDim2.fromOffset(0, 0) }, 0.2)
    tween(Holder.UIStroke, { Transparency = 0.25 }, 0.2)
    tween(Bar, { Size = UDim2.new(0, 0, 0, 3) }, Duration, Enum.EasingStyle.Linear)

    task.delay(Duration, closeNotification)
    return Holder
end

