    local Root = panel({
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 0.04,
        Position = Info.Position,
        Size = Info.Size,
        Visible = Window.Visible,
        Parent = ScreenGui,
    })
    Window.Root = Root

    local DockButton = buttonBase(Info.DockText)
    DockButton.AnchorPoint = Vector2.new(0, 1)
    DockButton.Position = UDim2.new(0, 24, 1, -24)
